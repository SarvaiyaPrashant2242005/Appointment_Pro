# Copy to .env and fill in. Used by docker-compose.yml. Never commit .env.
DB_NAME=appointment_pro
DB_USER=appointment_pro
DB_PASSWORD=change_me

JWT_ACCESS_SECRET=change_me_long_random_string
JWT_REFRESH_SECRET=change_me_another_long_random_string

# Host port for the API (bound to 127.0.0.1)
API_PORT=5000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
